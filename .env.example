# Copy to .env and fill in. SEC requires a descriptive User-Agent with contact info
# (https://www.sec.gov/os/webmaster-faq#developers). Requests without one get blocked.
SEC_USER_AGENT="Supply Chain Atlas research your-email@example.com"
DATABASE_URL="postgresql://atlas:atlas@localhost:5432/atlas"

# Conservative default under SEC's 10 req/s fair-access ceiling.
RATE_LIMIT_RPS=8

# Max documents to download per `fetch-docs` run (keeps runs bounded).
DOC_FETCH_LIMIT=200

# Connection pool bounds (v2: psycopg_pool replaces per-statement connections).
DB_POOL_MIN=1
DB_POOL_MAX=8

# MLflow tracking server (Docker Compose service; host processes use localhost).
MLFLOW_TRACKING_URI="http://localhost:5000"

# Local LLM for the supply-chain NLP overlay (host-run Ollama).
OLLAMA_URL="http://localhost:11434"

# Kafka bootstrap for host-run producers/consumers (EXTERNAL listener).
KAFKA_BOOTSTRAP="localhost:19092"

# Shared JWT secret for Airflow multi-container task auth (any random string).
AIRFLOW_JWT_SECRET="atlas-local-jwt-secret-change-me"
